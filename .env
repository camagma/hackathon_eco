# NVIDIA Build API Key
NVIDIA_API_KEY=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

# Base URL:
# Для локального контейнера NVIDIA NIM qwen/qwen-image-edit:
# Важно: само веб-приложение запускается на 7860, чтобы не занимать порт NIM.
NVIDIA_BASE_URL=http://localhost:8000/v1

# Модель по умолчанию
NVIDIA_MODEL=qwen/qwen-image-edit

# Порт веб-сервера
SERVER_PORT=7860
SERVER_HOST=127.0.0.1

# Альтернатива без локального NVIDIA NIM: QwenCloud/DashScope hosted API
# DASHSCOPE_API_KEY=your_dashscope_key
# QWEN_IMAGE_EDIT_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1

# Альтернатива для Mac без NVIDIA GPU: Hugging Face Inference Providers
# HF_TOKEN=hf_your_token_here
# QWEN_IMAGE_EDIT_BASE_URL=https://api-inference.huggingface.co
# HF_PROVIDER=auto

# Активный hosted provider для Mac без NVIDIA GPU
QWEN_IMAGE_EDIT_BASE_URL=https://api-inference.huggingface.co
HF_PROVIDER=auto
