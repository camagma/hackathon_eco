# NVIDIA Build API key (get one at https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your_api_key_here

# Base URL:
# For a local qwen/qwen-image-edit NVIDIA NIM container:
# The web application runs on port 7860 so it does not occupy the NIM port.
NVIDIA_BASE_URL=http://localhost:8000/v1

# Default model
NVIDIA_MODEL=qwen/qwen-image-edit

# Web server host and port
SERVER_PORT=7860
SERVER_HOST=0.0.0.0

# Alternative without local NVIDIA NIM: hosted QwenCloud/DashScope API
# DASHSCOPE_API_KEY=your_dashscope_key
# QWEN_IMAGE_EDIT_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1

# Alternative for a Mac without an NVIDIA GPU: Hugging Face Inference Providers
# HF_TOKEN=hf_your_token_here
# QWEN_IMAGE_EDIT_BASE_URL=https://api-inference.huggingface.co
# HF_PROVIDER=auto

# Active hosted provider for a Mac without an NVIDIA GPU
QWEN_IMAGE_EDIT_BASE_URL=https://api-inference.huggingface.co
HF_PROVIDER=auto
